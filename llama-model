#!/bin/sh

# A small, POSIX-sh launcher for llama.cpp's llama-server.

set -eu

VERSION=dev

CONFIG_HOME=${XDG_CONFIG_HOME:-$HOME/.config}
CONFIG_FILE=${LLAMA_MODELS_CONFIG:-$CONFIG_HOME/llama-models.conf}

if [ -r "$CONFIG_FILE" ]; then
    # This is a user-owned shell configuration file.
    . "$CONFIG_FILE"
fi

LLAMA_SERVER=${LLAMA_SERVER:-$HOME/src/github/ggml-org/llama.cpp/build/bin/llama-server}
LLAMA_MODEL_ROOT=${LLAMA_MODEL_ROOT:-$HOME/models/catalog}
LLAMA_GLOBAL_ARGS=${LLAMA_GLOBAL_ARGS:-$LLAMA_MODEL_ROOT/server.args}

usage() {
    cat <<'EOF'
usage:
  llama-model list
  llama-model show ALIAS
  llama-model add ALIAS MODEL_GGUF [MMPROJ_GGUF]
  llama-model run ALIAS [LLAMA_SERVER_ARGS ...]
  llama-model command ALIAS [LLAMA_SERVER_ARGS ...]
  llama-model start ALIAS [LLAMA_SERVER_ARGS ...]
  llama-model stop ALIAS
  llama-model restart ALIAS [LLAMA_SERVER_ARGS ...]
  llama-model status [ALIAS]
  llama-model --version

Each model lives under $LLAMA_MODEL_ROOT/ALIAS and has stable links named
model.gguf and, for a vision model, mmproj.gguf. Put global server options in
$LLAMA_MODEL_ROOT/server.args and per-model options in ALIAS/server.args,
with exactly one argument per line.

add writes a --port into the new alias's server.args automatically, one past
the highest --port already in use across the global args file and every
other alias, so newly added models don't collide on the default port.

start runs a model detached in the background, logging to ALIAS/server.log
and tracking it via ALIAS/server.pid and ALIAS/server.addr; stop and status
use those files. restart stops it first if running, then starts it again.

Anywhere ALIAS is accepted, a plain number is also accepted as the 1-based
index shown by 'llama-model list' or 'llama-model status' (that index is
positional and can shift as models are added or removed).
EOF
}

die() {
    printf '%s\n' "llama-model: $*" >&2
    exit 1
}

check_alias() {
    case $1 in
        ''|*[!A-Za-z0-9._-]*)
            die "invalid alias '$1' (use letters, digits, dot, underscore, or dash)"
            ;;
    esac
}

model_dir() {
    printf '%s/%s\n' "$LLAMA_MODEL_ROOT" "$1"
}

list_aliases() {
    [ -d "$LLAMA_MODEL_ROOT" ] || return 0
    for directory in "$LLAMA_MODEL_ROOT"/*; do
        [ -f "$directory/model.gguf" ] || continue
        printf '%s\n' "${directory##*/}"
    done | sort
}

resolve_ref() {
    # A purely numeric ref is a 1-based index into 'list_aliases' output
    # (as shown by 'llama-model list'/'status'); anything else passes
    # through unchanged as a literal alias name.
    case $1 in
        ''|*[!0-9]*)
            printf '%s\n' "$1"
            return
            ;;
    esac
    n=$1
    i=0
    for name in $(list_aliases); do
        i=$((i + 1))
        if [ "$i" -eq "$n" ]; then
            printf '%s\n' "$name"
            return
        fi
    done
    die "no model at index $n (see 'llama-model list')"
}

read_args() {
    args_file=$1
    [ -r "$args_file" ] || return 0

    while IFS= read -r arg || [ -n "$arg" ]; do
        case $arg in
            ''|'#'*) continue ;;
        esac
        printf '%s\n' "$arg"
    done < "$args_file"
}

resolve_file() {
    resolved=$(realpath "$1" 2>/dev/null) || die "cannot resolve '$1'"
    [ -f "$resolved" ] || die "not a regular file: $resolved"
    printf '%s\n' "$resolved"
}

next_free_port() {
    # Highest --port seen across the global args file and every existing
    # alias's server.args, plus one; 8080 (llama-server's own default) if
    # none is set anywhere yet.
    max=$(
        {
            read_args "$LLAMA_GLOBAL_ARGS"
            for directory in "$LLAMA_MODEL_ROOT"/*; do
                [ -f "$directory/model.gguf" ] || continue
                read_args "$directory/server.args"
            done
        } 2>/dev/null | awk '
            /^--port$/ { getline p; if (p + 0 > max + 0) max = p + 0 }
            END { print max + 0 }
        '
    )
    if [ "$max" -eq 0 ]; then
        printf '8080\n'
    else
        printf '%s\n' "$((max + 1))"
    fi
}

pid_is_running() {
    kill -0 "$1" 2>/dev/null
}

alias_index() {
    target=$1
    i=0
    for name in $(list_aliases); do
        i=$((i + 1))
        if [ "$name" = "$target" ]; then
            printf '%s\n' "$i"
            return
        fi
    done
}

status_row() {
    alias_name=$1
    idx=$2
    directory=$(model_dir "$alias_name")
    pid_file="$directory/server.pid"
    addr_file="$directory/server.addr"
    if [ -f "$pid_file" ] && pid_is_running "$(cat "$pid_file")"; then
        state=running
        pid=$(cat "$pid_file")
        addr=-
        [ ! -f "$addr_file" ] || addr="http://$(cat "$addr_file")"
    else
        # A pid file that didn't pass pid_is_running is stale (the process
        # died without going through 'stop'); reap it so status doesn't
        # keep reporting leftover state indefinitely.
        [ ! -f "$pid_file" ] || rm -f "$pid_file" "$addr_file"
        state=stopped
        pid=-
        addr=-
    fi
    printf '%s\t%s\t%s\t%s\t%s\n' "$idx" "$alias_name" "$state" "$pid" "$addr"
}

render_table() {
    # Read tab-separated rows (first row is the header) from stdin and
    # print them as an ASCII box table, sized to the widest cell per column.
    awk -F '\t' '
        {
            n++
            for (i = 1; i <= NF; i++) {
                row[n, i] = $i
                if (length($i) > w[i]) w[i] = length($i)
            }
            if (n == 1) ncols = NF
        }
        END {
            if (n == 0) exit
            sep = "+"
            for (i = 1; i <= ncols; i++) {
                for (j = 0; j < w[i] + 2; j++) sep = sep "-"
                sep = sep "+"
            }
            print sep
            for (r = 1; r <= n; r++) {
                line = "|"
                for (i = 1; i <= ncols; i++) {
                    cell = row[r, i]
                    line = line " " cell
                    for (j = length(cell); j < w[i]; j++) line = line " "
                    line = line " |"
                }
                print line
                if (r == 1) print sep
            }
            print sep
        }
    '
}

last_flag_value() {
    # Scan "$@" (already split on the delimiter used by llama-server's
    # last-flag-wins semantics) for the last value of a given flag, e.g.
    # --port. Prints nothing if the flag is absent.
    flag=$1
    shift
    value=
    prev=
    for arg do
        [ "$prev" != "$flag" ] || value=$arg
        prev=$arg
    done
    [ -z "$value" ] || printf '%s\n' "$value"
}

quote_arg() {
    # Print one argument in a form suitable for copying into a POSIX shell.
    escaped=$(printf '%s' "$1" | sed "s/'/'\\\\''/g")
    printf "'%s'" "$escaped"
}

prepare_command() {
    alias_name=$1
    shift
    check_alias "$alias_name"

    directory=$(model_dir "$alias_name")
    model=$directory/model.gguf
    projector=$directory/mmproj.gguf

    [ -f "$model" ] || die "unknown alias '$alias_name' (missing $model)"

    # Newline is the delimiter for args files, so values may contain spaces.
    old_ifs=$IFS
    IFS='
'
    global_args=$(read_args "$LLAMA_GLOBAL_ARGS")
    model_args=$(read_args "$directory/server.args")
    set -f
    if [ -n "$model_args" ]; then
        set -- $model_args "$@"
    fi
    if [ -n "$global_args" ]; then
        set -- $global_args "$@"
    fi
    set +f
    IFS=$old_ifs

    if [ -f "$projector" ]; then
        set -- --model "$model" --mmproj "$projector" --alias "$alias_name" "$@"
    else
        set -- --model "$model" --alias "$alias_name" "$@"
    fi

    PREPARED_ARGS=$(printf '%s\n' "$@")
}

do_start() {
    alias_name=$1
    shift
    directory=$(model_dir "$alias_name")
    pid_file="$directory/server.pid"
    addr_file="$directory/server.addr"
    log_file="$directory/server.log"

    if [ -f "$pid_file" ] && pid_is_running "$(cat "$pid_file")"; then
        die "'$alias_name' is already running (pid $(cat "$pid_file"))"
    fi

    prepare_command "$alias_name" "$@"

    old_ifs=$IFS
    IFS='
'
    set -f
    set -- $PREPARED_ARGS
    set +f
    IFS=$old_ifs

    [ -x "$LLAMA_SERVER" ] || die "llama-server is not executable: $LLAMA_SERVER"

    host=$(last_flag_value --host "$@")
    port=$(last_flag_value --port "$@")
    host=${host:-127.0.0.1}
    port=${port:-8080}

    nohup "$LLAMA_SERVER" "$@" >"$log_file" 2>&1 < /dev/null &
    server_pid=$!
    printf '%s\n' "$server_pid" > "$pid_file"
    printf '%s:%s\n' "$host" "$port" > "$addr_file"
    printf 'Started %s (pid %s) at http://%s:%s, logging to %s\n' "$alias_name" "$server_pid" "$host" "$port" "$log_file"
}

do_stop() {
    alias_name=$1
    directory=$(model_dir "$alias_name")
    pid_file="$directory/server.pid"
    addr_file="$directory/server.addr"
    [ -f "$pid_file" ] || die "'$alias_name' is not running (no pid file)"
    server_pid=$(cat "$pid_file")
    if ! pid_is_running "$server_pid"; then
        rm -f "$pid_file" "$addr_file"
        die "'$alias_name' is not running (stale pid file removed)"
    fi
    kill "$server_pid"
    printf 'Stopping %s (pid %s)...\n' "$alias_name" "$server_pid"
    i=0
    while pid_is_running "$server_pid"; do
        i=$((i + 1))
        [ "$i" -le 15 ] || die "'$alias_name' (pid $server_pid) did not stop after SIGTERM; try 'kill -9 $server_pid'"
        sleep 1
    done
    rm -f "$pid_file" "$addr_file"
    printf 'Stopped %s\n' "$alias_name"
}

cmd=${1:-}
case $cmd in
    list)
        [ "$#" -eq 1 ] || die "list takes no arguments"
        i=0
        for name in $(list_aliases); do
            i=$((i + 1))
            printf '%s\t%s\n' "$i" "$name"
        done
        ;;

    show)
        [ "$#" -eq 2 ] || die "show requires one alias"
        alias_name=$(resolve_ref "$2")
        check_alias "$alias_name"
        directory=$(model_dir "$alias_name")
        [ -f "$directory/model.gguf" ] || die "unknown alias '$alias_name'"
        printf 'alias:  %s\n' "$alias_name"
        printf 'model:  %s\n' "$(realpath "$directory/model.gguf")"
        if [ -f "$directory/mmproj.gguf" ]; then
            printf 'mmproj: %s\n' "$(realpath "$directory/mmproj.gguf")"
        else
            printf 'mmproj: (none)\n'
        fi
        [ ! -r "$directory/server.args" ] || printf 'args:   %s\n' "$directory/server.args"
        ;;

    add)
        [ "$#" -eq 3 ] || [ "$#" -eq 4 ] || die "add requires alias, model, and optional mmproj"
        check_alias "$2"
        directory=$(model_dir "$2")
        [ ! -e "$directory" ] || die "alias '$2' already exists"
        model=$(resolve_file "$3")
        projector=
        [ "$#" -eq 3 ] || projector=$(resolve_file "$4")
        mkdir -p "$directory"
        ln -s "$model" "$directory/model.gguf"
        if [ -n "$projector" ]; then
            ln -s "$projector" "$directory/mmproj.gguf"
        fi
        port=$(next_free_port)
        printf -- '--port\n%s\n' "$port" > "$directory/server.args"
        printf 'Added %s (port %s)\n' "$2" "$port"
        ;;

    run|command)
        [ "$#" -ge 2 ] || die "$cmd requires an alias"
        action=$cmd
        alias_name=$(resolve_ref "$2")
        shift 2
        prepare_command "$alias_name" "$@"

        old_ifs=$IFS
        IFS='
'
        set -f
        set -- $PREPARED_ARGS
        set +f
        IFS=$old_ifs

        if [ "$action" = command ]; then
            quote_arg "$LLAMA_SERVER"
            for arg do
                printf ' '
                quote_arg "$arg"
            done
            printf '\n'
            exit 0
        fi

        [ -x "$LLAMA_SERVER" ] || die "llama-server is not executable: $LLAMA_SERVER"
        exec "$LLAMA_SERVER" "$@"
        ;;

    start)
        [ "$#" -ge 2 ] || die "start requires an alias"
        alias_name=$(resolve_ref "$2")
        shift 2
        check_alias "$alias_name"
        do_start "$alias_name" "$@"
        ;;

    stop)
        [ "$#" -eq 2 ] || die "stop requires one alias"
        alias_name=$(resolve_ref "$2")
        check_alias "$alias_name"
        do_stop "$alias_name"
        ;;

    restart)
        [ "$#" -ge 2 ] || die "restart requires an alias"
        alias_name=$(resolve_ref "$2")
        shift 2
        check_alias "$alias_name"
        directory=$(model_dir "$alias_name")
        pid_file="$directory/server.pid"
        if [ -f "$pid_file" ] && pid_is_running "$(cat "$pid_file")"; then
            do_stop "$alias_name"
        fi
        do_start "$alias_name" "$@"
        ;;

    status)
        [ "$#" -eq 1 ] || [ "$#" -eq 2 ] || die "status takes zero or one alias"
        if [ "$#" -eq 2 ]; then
            alias_name=$(resolve_ref "$2")
            check_alias "$alias_name"
            idx=$(alias_index "$alias_name")
            {
                printf 'ID\tALIAS\tSTATE\tPID\tADDRESS\n'
                status_row "$alias_name" "$idx"
            } | render_table
        else
            {
                printf 'ID\tALIAS\tSTATE\tPID\tADDRESS\n'
                i=0
                for name in $(list_aliases); do
                    i=$((i + 1))
                    status_row "$name" "$i"
                done
            } | render_table
        fi
        ;;

    -h|--help|help)
        usage
        ;;

    -v|--version|version)
        printf 'llama-model %s\n' "$VERSION"
        ;;

    '')
        usage >&2
        exit 2
        ;;

    *)
        die "unknown command '$cmd'"
        ;;
esac
